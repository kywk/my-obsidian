{
  "name": "my-obsidian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在瀏覽器執行官方 Obsidian renderer，由自架 Node 服務提供 vault 檔案 API",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor": "node scripts/fetch-obsidian.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "doctor": "node scripts/start.mjs --doctor",
    "test": "npm --prefix packages/server test",
    "test:unit": "npm --prefix packages/server test",
    "check:spike": "node tools/spike-check.mjs",
    "check:hotreload": "node tools/hotreload-check.mjs",
    "check:attachment": "node tools/attachment-check.mjs",
    "check:popout": "node tools/popout-check.mjs",
    "check:menu": "node tools/menu-check.mjs",
    "check:print": "node tools/print-check.mjs",
    "check:dialog": "node tools/dialog-check.mjs",
    "check:plugin-install": "node tools/plugin-install-check.mjs",
    "check:notices": "node tools/notices-check.mjs",
    "check:resilience": "node tools/resilience-check.mjs",
    "check:parity": "node tools/parity-check.mjs",
    "check:plugin-support": "node tools/plugin-support-check.mjs",
    "audit:plugins": "node tools/plugin-audit.mjs",
    "check:templater": "node tools/templater-check.mjs",
    "check:geo-story-map": "node tools/geo-story-map-check.mjs",
    "check:vault-feed-reader": "node tools/vault-feed-reader-check.mjs",
    "check:kanban": "node tools/kanban-check.mjs",
    "check:dataview": "node tools/dataview-check.mjs",
    "check:tasks": "node tools/tasks-check.mjs",
    "check:quickadd": "node tools/quickadd-check.mjs",
    "check:origin-echo": "node tools/origin-echo-check.mjs"
  }
}
